{
  "name": "maplibregl-recorder",
  "version": "0.0.4",
  "description": "Records the calls an application makes into maplibre-gl-js and exports them as a self-contained page that replays them, for minimal bug reproductions",
  "keywords": [
    "maplibre-gl-js",
    "debug",
    "record",
    "replay",
    "reproduction"
  ],
  "homepage": "https://github.com/HarelM/maplibregl-recorder#readme",
  "bugs": {
    "url": "https://github.com/HarelM/maplibregl-recorder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarelM/maplibregl-recorder.git"
  },
  "author": "Harel Mazor",
  "license": "MIT",
  "type": "module",
  "module": "dist/maplibregl-recorder.mjs",
  "types": "dist/maplibregl-recorder.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maplibregl-recorder.d.ts",
      "import": "./dist/maplibregl-recorder.mjs"
    },
    "./dist/maplibregl-recorder.css": "./dist/maplibregl-recorder.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "build:watch": "rolldown -c -w",
    "build-dist": "npm run build && npm run build-css",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --out docs src/index.ts && cp -rf dist docs/ && mkdir -p docs/demo && cp test/demo.html docs/demo/index.html",
    "build-css": "mkdir -p dist && cp src/recorder-control.css dist/maplibregl-recorder.css"
  },
  "peerDependencies": {
    "maplibre-gl": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "maplibre-gl": "^6.16.0",
    "playwright": "^1.64.1",
    "rolldown": "^1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "style": "dist/maplibregl-recorder.css"
}
